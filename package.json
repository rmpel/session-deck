{
  "name": "session-deck",
  "version": "0.4.0",
  "private": true,
  "description": "Dashboard for Claude Code sessions across LocalWP sites",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "install-hooks": "node scripts/install-integration.mjs",
    "fix-pty": "node scripts/fix-node-pty.mjs",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "pack": "electron-vite build && electron-builder --mac dir",
    "status": "curl -s -H \"X-Deck-Token: $(cat ~/.session-deck/token)\" http://127.0.0.1:47823/sessions",
    "preview": "electron scripts/preview/render.cjs",
    "install-integration": "node scripts/install-integration.mjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:all": "electron-vite build && electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@fontsource-variable/antonio": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "productName": "Session Deck",
  "build": {
    "appId": "io.github.frankabeekman.session-deck",
    "productName": "Session Deck",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/node-pty/build/**/*"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "extraResources": [
      {
        "from": "src/main/mcp-bridge.mjs",
        "to": "mcp-bridge.mjs"
      },
      {
        "from": "src/main/hook-client.mjs",
        "to": "hook-client.mjs"
      },
      {
        "from": "resources/backgrounds",
        "to": "backgrounds"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Session Deck"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
